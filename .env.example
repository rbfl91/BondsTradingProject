# ── Bond Trading API — Environment Variables ──
# Copy this file to .env and fill in the values.

# Blockchain provider (Ganache / Hardhat / local node)
WEB3_PROVIDER=http://127.0.0.1:8545

# Deployed BondTrading contract address (set after `npm run deploy`;
# lowercase values are accepted and normalized automatically)
CONTRACT_ADDRESS=

# Ethereum account used for owner transactions (optional — defaults to first provider account)
OWNER_ADDRESS=

# API authentication token (REQUIRED — generate with: openssl rand -hex 32).
# H-04: put the SAME value into frontend/.env (AUTH_TOKEN) so the Vite dev
# proxy can inject it server-side; the token never reaches the browser bundle.
AUTH_TOKEN=

# CoinMarketCap API key (optional — for crypto market data)
COINMARKETCAP_API_KEY=

# Trust X-Forwarded-For when picking the client IP for rate limiting.
# Enable ONLY when the API sits behind a trusted reverse proxy
# (nginx, Cloudflare, ...); with an untrusted open proxy anyone could
# spoof their IP and evade the limiter.
TRUST_PROXY=false

# API server settings
PORT=5000
LOG_LEVEL=INFO
DEBUG=false

# CORS: comma-separated list of allowed frontend origins (optional)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
