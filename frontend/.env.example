# ── Frontend .env ──
# Copy to frontend/.env (this file is a template; .env is untracked/local-only)

# API base URL (proxied through Vite in dev)
VITE_API_URL=/api

# H-04: operator API token — read by the Vite DEV PROXY (vite.config.js),
# which injects "Authorization: Bearer <token>" server-side. It is NOT baked
# into the JS bundle and never reaches the browser. Must match the API's
# AUTH_TOKEN (see root .env).
# Leave empty to rely on the runtime "API Token" prompt in the UI instead.
AUTH_TOKEN=

# Block explorer URL (optional — defaults to Etherscan)
# VITE_BLOCK_EXPLORER=https://etherscan.io
